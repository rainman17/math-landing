# Скопируйте в deploy/.env.production и заполните. Файл не коммитить.

# Домен сайта (A-запись должна указывать на сервер) и публичный адрес
DOMAIN=example.ru
SITE_URL=https://example.ru

# База данных (контейнер postgres)
POSTGRES_USER=mkm
POSTGRES_PASSWORD=
POSTGRES_DB=mkm

# Секрет админки: openssl rand -hex 32
PAYLOAD_SECRET=

# Уведомления преподавателю в Telegram (необязательно)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_INCLUDE_CONTACTS=false

# Копия заявок в CRM / таблицу (необязательно)
LEADS_WEBHOOK_URL=
LEADS_WEBHOOK_SECRET=
