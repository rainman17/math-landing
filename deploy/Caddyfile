# Caddy сам получает и продлевает HTTPS-сертификат для домена из переменной DOMAIN.
{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	# Загрузки картинок в админке — не больше 10 МБ
	request_body {
		max_size 10MB
	}

	reverse_proxy app:3000
}

# www → без www
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
