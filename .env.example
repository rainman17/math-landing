# --- Обязательные ---
# Подключение к PostgreSQL
DATABASE_URL=postgres://mkm:mkm@127.0.0.1:5432/mkm
# Секрет для подписи сессий админки: openssl rand -hex 32
PAYLOAD_SECRET=
# Публичный адрес сайта без слеша в конце (canonical, sitemap, ссылки в уведомлениях)
SITE_URL=http://localhost:3000

# --- Уведомления преподавателю в Telegram (необязательно) ---
# Токен бота от @BotFather и id чата, куда бот пишет (бот должен быть добавлен в чат)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# true — включать в уведомление контакты родителя. По умолчанию только класс, цель и ссылка в админку
TELEGRAM_INCLUDE_CONTACTS=false

# --- Копия заявок в CRM или Google-таблицу (необязательно) ---
# Получатель обновляет строку по lead_id; пример для Google Apps Script — integrations/google-sheets.gs
LEADS_WEBHOOK_URL=
# Если задан, тело подписывается HMAC-SHA256 в заголовке x-mkm-signature
LEADS_WEBHOOK_SECRET=

# --- Прочее ---
# Хосты, с которых разрешено открывать dev-сервер (npm run dev:lan), через запятую: 192.168.1.10
# Для доступа из локальной сети укажите тот же адрес и в SITE_URL: http://192.168.1.10:3000
DEV_ORIGINS=
# Каталог для загруженных изображений (по умолчанию ./media)
MEDIA_DIR=
# false — не запускать фоновые задачи в этом процессе
JOBS_AUTORUN=true
